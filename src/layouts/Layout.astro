---
import '../styles/global.css';

interface Props {
	title: string;
    description: string;
    pageId: string;
}

const { title, description, pageId } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        
        <!-- SEO Tags -->
		<title>{title}</title>
        <meta name="description" content={description} />
        <meta name="keywords" content="marketing agency for architect, marketing agency for interior design, web development bhopal, digital marketing agency bhopal, SEO services bhopal, QuantumFrame Studio" />
        
        <link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        <!-- Prevent flash of wrong theme + logo -->
        <script is:inline>
            (function() {
                const saved = localStorage.getItem('qfs-theme');
                if (saved === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    // light is default — swap logo src after DOM loads
                    document.addEventListener('DOMContentLoaded', function() {
                        document.querySelectorAll('.qfs-logo').forEach(function(img) {
                            img.src = '/assets/images/logo-light.png';
                        });
                    });
                }
            })();
        </script>

        <!-- Lenis Smooth Scroll -->
        <script is:inline src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>

        <style is:global>
            * { box-sizing: border-box; }
            #qfs-page-wrapper {
                animation: qfs-page-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
            }
            @keyframes qfs-page-in {
                from { opacity: 0; transform: translateY(14px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            /* No filter on logo — we swap src based on theme instead */
            .qfs-logo { transition: opacity 0.3s ease; }
        </style>
	</head>
	<body id={`qfs-${pageId}-body`} class="bg-background text-foreground">

        <!-- Cursor (before any overflow wrapper) -->
        <div id="qfs-cursor-dot"  class="fixed w-3 h-3 rounded-full pointer-events-none z-[9999] hidden md:block" style="background:var(--primary);top:0;left:0;transform:translate(-50%,-50%);will-change:left,top;"></div>
        <div id="qfs-cursor-ring" class="fixed w-10 h-10 rounded-full pointer-events-none z-[9998] hidden md:block" style="border:2px solid var(--primary);opacity:0.5;top:0;left:0;transform:translate(-50%,-50%);will-change:left,top;transition:transform 0.2s ease,border-color 0.2s ease,opacity 0.2s ease;"></div>

        <!-- Page wrapper for exit transitions -->
        <div id="qfs-page-wrapper">

            <!-- Navbar -->
            <nav id={`qfs-${pageId}-navbar`} class="fixed top-0 w-full z-50 backdrop-blur-md border-b transition-all duration-300 px-6 py-3 flex justify-between items-center pointer-events-none" style="background:var(--background);border-color:var(--border);">
                <a href="/" class="pointer-events-auto hover:opacity-80 transition-opacity flex items-center">
                    <img src="/assets/images/logo.png" alt="QuantumFrame Studio Logo" class="qfs-logo h-16 md:h-24 w-auto object-contain scale-150 origin-left transition-all duration-300" id="qfs-nav-logo" />
                </a>

                <div class="hidden md:flex gap-8 text-sm font-semibold tracking-wide pointer-events-auto" style="color:var(--muted-foreground);">
                    <a href="/about"        class="hover:text-foreground transition-colors" style="color:inherit;">About Us</a>
                    <a href="/services"     class="hover:text-foreground transition-colors" style="color:inherit;">Services</a>
                    <a href="/case-studies" class="hover:text-foreground transition-colors" style="color:inherit;">Case Studies</a>
                    <a href="/contact"      class="hover:text-foreground transition-colors" style="color:inherit;">Contact</a>
                </div>

                <div class="flex items-center gap-5 pointer-events-auto">
                    <!-- Dark / Light toggle -->
                    <button id="qfs-theme-toggle" aria-label="Toggle theme" class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest" style="color:var(--muted-foreground);">
                        <span id="qfs-theme-icon" class="text-base">☀️</span>
                        <div class="qfs-toggle-track">
                            <div class="qfs-toggle-thumb"></div>
                        </div>
                        <span id="qfs-theme-label" class="hidden md:inline">Light</span>
                    </button>

                    <a href="/get-quote" class="qfs-shimmer text-sm font-bold tracking-wide uppercase px-5 py-2 transition-all rounded-full hidden sm:block" style="background:var(--primary);color:var(--primary-foreground);">Get a Quote</a>
                    
                    <!-- Mobile Menu Button -->
                    <button id="qfs-mobile-menu-btn" aria-label="Open mobile menu" class="md:hidden flex flex-col justify-center items-center gap-1.5 w-8 h-8">
                        <span class="w-6 h-0.5 bg-current transition-transform duration-300"></span>
                        <span class="w-6 h-0.5 bg-current transition-transform duration-300"></span>
                        <span class="w-6 h-0.5 bg-current transition-transform duration-300"></span>
                    </button>
                </div>
            </nav>

            <!-- Mobile Menu Drawer -->
            <div id="qfs-mobile-drawer" class="fixed inset-0 z-40 transform translate-x-full transition-transform duration-500 ease-in-out flex flex-col pt-32 px-8 pb-8" style="background:var(--background);">
                <div class="flex flex-col gap-6 text-2xl font-black uppercase tracking-widest mt-8">
                    <a href="/"             class="mobile-link hover:opacity-70" style="color:var(--foreground);">Home</a>
                    <a href="/about"        class="mobile-link hover:opacity-70" style="color:var(--foreground);">About Us</a>
                    <a href="/services"     class="mobile-link hover:opacity-70" style="color:var(--foreground);">Services</a>
                    <a href="/case-studies" class="mobile-link hover:opacity-70" style="color:var(--foreground);">Case Studies</a>
                    <a href="/contact"      class="mobile-link hover:opacity-70" style="color:var(--foreground);">Contact</a>
                    <a href="/get-quote"    class="mobile-link hover:opacity-70" style="color:var(--primary);">Get a Quote</a>
                </div>
            </div>

		    <slot />

            <!-- Footer -->
            <footer class="border-t px-6 md:px-12 py-16" style="background:var(--card);border-color:var(--border);">
                <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
                    <div class="md:col-span-2">
                        <img src="/assets/images/logo.png" alt="QuantumFrame Studio" class="qfs-logo h-12 w-auto object-contain mb-4 transition-all duration-300" />
                        <p class="text-sm leading-relaxed max-w-sm" style="color:var(--muted-foreground);">Bhopal's premier web development and digital marketing agency. Building empires one project at a time.</p>
                        <div class="flex gap-4 mt-6">
                            <a href="https://facebook.com" target="_blank" class="text-xs font-bold uppercase tracking-widest hover:text-primary transition-colors" style="color:var(--muted-foreground);">Facebook</a>
                            <a href="https://twitter.com" target="_blank" class="text-xs font-bold uppercase tracking-widest hover:text-primary transition-colors" style="color:var(--muted-foreground);">Twitter</a>
                            <a href="https://instagram.com" target="_blank" class="text-xs font-bold uppercase tracking-widest hover:text-primary transition-colors" style="color:var(--muted-foreground);">Instagram</a>
                            <a href="https://linkedin.com" target="_blank" class="text-xs font-bold uppercase tracking-widest hover:text-primary transition-colors" style="color:var(--muted-foreground);">LinkedIn</a>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-xs uppercase tracking-widest font-bold mb-6" style="color:var(--muted-foreground);">Navigation</h4>
                        <ul class="space-y-3 text-sm font-medium">
                            <li><a href="/"            class="hover:text-primary transition-colors" style="color:var(--foreground);">Home</a></li>
                            <li><a href="/about"        class="hover:text-primary transition-colors" style="color:var(--foreground);">About Us</a></li>
                            <li><a href="/services"     class="hover:text-primary transition-colors" style="color:var(--foreground);">Services</a></li>
                            <li><a href="/case-studies" class="hover:text-primary transition-colors" style="color:var(--foreground);">Case Studies</a></li>
                            <li><a href="/contact"      class="hover:text-primary transition-colors" style="color:var(--foreground);">Contact</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="text-xs uppercase tracking-widest font-bold mb-6" style="color:var(--muted-foreground);">Contact</h4>
                        <ul class="space-y-3 text-sm">
                            <li><a href="mailto:info@quantumframestudio.com" class="hover:text-primary transition-colors" style="color:var(--foreground);">info@quantumframestudio.com</a></li>
                            <li><a href="tel:+919243015433" class="hover:text-primary transition-colors" style="color:var(--foreground);">+91 9243015433</a></li>
                            <li style="color:var(--muted-foreground);">Bhopal, Madhya Pradesh</li>
                        </ul>
                    </div>
                </div>
                <div class="max-w-7xl mx-auto mt-12 pt-8 border-t flex flex-col md:flex-row justify-between items-center gap-4" style="border-color:var(--border);">
                    <p class="text-xs" style="color:var(--muted-foreground);">© 2026 QuantumFrame Studio. All rights reserved.</p>
                    <p class="text-xs" style="color:var(--muted-foreground);">Built with ❤️ in Bhopal, Madhya Pradesh</p>
                </div>
            </footer>

        </div><!-- end #qfs-page-wrapper -->

        <script is:inline define:vars={{ pageId }}>
            (function () {

                /* ── Theme Toggle ──────────────────────────────────────── */
                const html    = document.documentElement;
                const btn     = document.getElementById('qfs-theme-toggle');
                const icon    = document.getElementById('qfs-theme-icon');
                const label   = document.getElementById('qfs-theme-label');

                function applyTheme(isDark) {
                    const logos = document.querySelectorAll('.qfs-logo');
                    if (isDark) {
                        html.classList.add('dark');
                        if (icon)  icon.textContent  = '🌙';
                        if (label) label.textContent = 'Dark';
                        logos.forEach(img => { img.src = '/assets/images/logo.png'; });
                    } else {
                        html.classList.remove('dark');
                        if (icon)  icon.textContent  = '☀️';
                        if (label) label.textContent = 'Light';
                        logos.forEach(img => { img.src = '/assets/images/logo-light.png'; });
                    }
                }

                // Init from saved preference
                applyTheme(html.classList.contains('dark'));

                btn?.addEventListener('click', () => {
                    const nowDark = !html.classList.contains('dark');
                    localStorage.setItem('qfs-theme', nowDark ? 'dark' : 'light');
                    applyTheme(nowDark);
                });

                /* ── Custom cursor ─────────────────────────────────────── */
                const dot  = document.getElementById('qfs-cursor-dot');
                const ring = document.getElementById('qfs-cursor-ring');
                let mx = 0, my = 0, rx = 0, ry = 0, rafRunning = false;

                window.addEventListener('mousemove', (e) => {
                    mx = e.clientX; my = e.clientY;
                    if (dot) { dot.style.left = mx + 'px'; dot.style.top = my + 'px'; }
                    if (!rafRunning) { rafRunning = true; requestAnimationFrame(lerp); }
                }, { passive: true });

                function lerp() {
                    if (!ring) return;
                    rx += (mx - rx) * 0.12;
                    ry += (my - ry) * 0.12;
                    ring.style.left = rx + 'px';
                    ring.style.top  = ry + 'px';
                    if (Math.abs(mx - rx) > 0.3 || Math.abs(my - ry) > 0.3) {
                        requestAnimationFrame(lerp);
                    } else { rafRunning = false; }
                }

                document.addEventListener('mouseover', (e) => {
                    if (e.target.closest('a,button,.qfs-hoverable,.group')) {
                        if (ring) { ring.style.transform = 'translate(-50%,-50%) scale(2.2)'; ring.style.opacity = '0.8'; }
                        if (dot)  dot.style.transform = 'translate(-50%,-50%) scale(0)';
                    }
                });
                document.addEventListener('mouseout', (e) => {
                    if (e.target.closest('a,button,.qfs-hoverable,.group')) {
                        if (ring) { ring.style.transform = 'translate(-50%,-50%) scale(1)'; ring.style.opacity = '0.5'; }
                        if (dot)  dot.style.transform = 'translate(-50%,-50%) scale(1)';
                    }
                });

                /* ── Scroll reveal ─────────────────────────────────────── */
                const revealEls = document.querySelectorAll('.qfs-reveal,.qfs-reveal-scale,.qfs-reveal-left');
                if (revealEls.length) {
                    const io = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
                    revealEls.forEach(el => io.observe(el));
                }

                /* ── Navbar shrink on scroll ───────────────────────────── */
                const nav = document.getElementById(`qfs-${pageId}-navbar`);
                window.addEventListener('scroll', () => {
                    if (!nav) return;
                    if (window.scrollY > 60) {
                        nav.classList.add('py-1', 'shadow-md');
                        nav.classList.remove('py-3');
                    } else {
                        nav.classList.remove('py-1', 'shadow-md');
                        nav.classList.add('py-3');
                    }
                }, { passive: true });

                /* ── Mobile Menu Logic ─────────────────────────────────── */
                const mobileBtn = document.getElementById('qfs-mobile-menu-btn');
                const mobileDrawer = document.getElementById('qfs-mobile-drawer');
                let menuOpen = false;

                mobileBtn?.addEventListener('click', () => {
                    menuOpen = !menuOpen;
                    if (menuOpen) {
                        mobileDrawer.classList.remove('translate-x-full');
                        mobileDrawer.classList.add('translate-x-0');
                        // Animate hamburger to X
                        const spans = mobileBtn.querySelectorAll('span');
                        spans[0].style.transform = 'translateY(8px) rotate(45deg)';
                        spans[1].style.opacity = '0';
                        spans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
                        document.body.style.overflow = 'hidden'; // prevent scrolling
                    } else {
                        mobileDrawer.classList.add('translate-x-full');
                        mobileDrawer.classList.remove('translate-x-0');
                        // Reset hamburger
                        const spans = mobileBtn.querySelectorAll('span');
                        spans[0].style.transform = 'none';
                        spans[1].style.opacity = '1';
                        spans[2].style.transform = 'none';
                        document.body.style.overflow = '';
                    }
                });

                /* ── Page-exit transition (opacity on wrapper only) ─────── */
                const wrapper = document.getElementById('qfs-page-wrapper');
                document.querySelectorAll('a[href^="/"]').forEach(link => {
                    link.addEventListener('click', (e) => {
                        const href = link.getAttribute('href');
                        if (href && !href.startsWith('/#') && href !== window.location.pathname) {
                            e.preventDefault();
                            if (wrapper) { wrapper.style.transition = 'opacity 0.22s ease'; wrapper.style.opacity = '0'; }
                            setTimeout(() => { window.location.href = href; }, 200);
                        }
                    });
                });

            })();

            /* ── Mindblowing Animations (Lenis, Tilt, Magnetic, Spotlight, Scramble) ── */
            document.addEventListener('DOMContentLoaded', () => {
                
                // 1. Lenis Smooth Scroll
                if (typeof Lenis !== 'undefined') {
                    const lenis = new Lenis({
                        duration: 1.2,
                        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                        direction: 'vertical',
                        gestureDirection: 'vertical',
                        smooth: true,
                    });
                    function raf(time) {
                        lenis.raf(time);
                        requestAnimationFrame(raf);
                    }
                    requestAnimationFrame(raf);
                }

                // 2. 3D Tilt & Spotlight for Cards
                const cards = document.querySelectorAll('.qfs-hoverable:not(.qfs-shimmer)');
                cards.forEach(card => {
                    card.classList.add('qfs-spotlight-card', 'qfs-tilt-card');
                    card.addEventListener('mousemove', e => {
                        const rect = card.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        
                        // Spotlight
                        card.style.setProperty('--mouse-x', `${x}px`);
                        card.style.setProperty('--mouse-y', `${y}px`);
                        
                        // 3D Tilt
                        const centerX = rect.width / 2;
                        const centerY = rect.height / 2;
                        const rotateX = ((y - centerY) / centerY) * -8; // Max 8 deg
                        const rotateY = ((x - centerX) / centerX) * 8;
                        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
                    });
                    card.addEventListener('mouseleave', () => {
                        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
                    });
                });

                // 3. Magnetic Buttons
                const magnets = document.querySelectorAll('.qfs-shimmer');
                magnets.forEach(btn => {
                    btn.classList.add('qfs-magnetic-btn');
                    btn.addEventListener('mousemove', e => {
                        const rect = btn.getBoundingClientRect();
                        const x = e.clientX - rect.left - rect.width / 2;
                        const y = e.clientY - rect.top - rect.height / 2;
                        btn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
                    });
                    btn.addEventListener('mouseleave', () => {
                        btn.style.transform = `translate(0px, 0px)`;
                    });
                });

                // 4. Scramble Text Effect (Hacker Text)
                class ScrambleText {
                    constructor(el) {
                        this.el = el;
                        // Using only standard-height uppercase and numbers to completely prevent vertical line-height jitter
                        this.chars = 'ABCDEF0123456789@#%&?!*+=';
                        this.original = el.innerText;
                        this.update = this.update.bind(this);
                    }
                    setText(newText) {
                        const length = Math.max(this.original.length, newText.length);
                        const promise = new Promise(resolve => this.resolve = resolve);
                        this.queue = [];
                        for (let i = 0; i < length; i++) {
                            const from = this.original[i] || '';
                            const to = newText[i] || '';
                            // Slower animation: increased start and end frame bounds
                            const start = Math.floor(Math.random() * 80);
                            const end = start + Math.floor(Math.random() * 80);
                            this.queue.push({ from, to, start, end });
                        }
                        cancelAnimationFrame(this.frameRequest);
                        this.frame = 0;
                        this.update();
                        return promise;
                    }
                    update() {
                        let output = '';
                        let complete = 0;
                        for (let i = 0, n = this.queue.length; i < n; i++) {
                            let { from, to, start, end, char } = this.queue[i];
                            if (this.frame >= end) {
                                complete++;
                                output += to;
                            } else if (this.frame >= start) {
                                // Slower character cycling: reduced probability from 0.28 to 0.12
                                if (!char || Math.random() < 0.12) {
                                    char = this.chars[Math.floor(Math.random() * this.chars.length)];
                                    this.queue[i].char = char;
                                }
                                output += `<span style="opacity: 0.3;">${char}</span>`;
                            } else {
                                output += from;
                            }
                        }
                        this.el.innerHTML = output;
                        if (complete === this.queue.length) {
                            this.resolve();
                        } else {
                            this.frameRequest = requestAnimationFrame(this.update);
                            this.frame++;
                        }
                    }
                }
                setTimeout(() => {
                    // Pre-lock the exact pixel height of all headings to completely eliminate jitter
                    document.querySelectorAll('.qfs-scramble').forEach(el => {
                        const heading = el.closest('h1, h2, h3, h4, h5, h6');
                        if (heading && !heading.style.minHeight) {
                            heading.style.minHeight = heading.offsetHeight + 'px';
                            heading.style.maxHeight = heading.offsetHeight + 'px';
                        }
                    });

                    document.querySelectorAll('.qfs-scramble').forEach(el => {
                        const fx = new ScrambleText(el);
                        const text = el.innerText;
                        el.innerText = '';
                        fx.setText(text);
                    });
                }, 400);
            });
        </script>
	</body>
</html>
