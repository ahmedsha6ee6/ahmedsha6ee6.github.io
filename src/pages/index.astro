---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="QuantumFrame Studio | Web Development & Marketing in Bhopal" 
    description="QuantumFrame Studio delivers cutting-edge website design, comprehensive SEO services, and strategic digital marketing in Bhopal, Indore, and Jabalpur."
    pageId="home"
>
	<main id="qfs-home-main" class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-36 pb-16 relative" style="background:var(--background);">
        
        <div id="qfs-home-content" class="relative z-10 max-w-7xl mx-auto w-full">
            <p id="qfs-home-eyebrow" class="uppercase tracking-widest text-xs font-bold mb-8 flex items-center gap-3 qfs-reveal" style="color:var(--primary);">
                <span class="w-2 h-2 rounded-full animate-pulse-slow" style="background:var(--primary);"></span>
                Best Web Development Services in Bhopal
            </p>
            <h1 id="qfs-home-heading" class="text-6xl md:text-[8.5rem] leading-[0.9] font-black tracking-tighter mb-12 qfs-reveal qfs-reveal-delay-1" style="color:var(--foreground);">
                <span class="qfs-scramble inline-block whitespace-nowrap">TRANSFORM</span> 
                <span class="qfs-scramble inline-block whitespace-nowrap">YOUR</span> <br>
                <span style="color:var(--primary);">
                    <span class="qfs-scramble inline-block whitespace-nowrap">DIGITAL</span> 
                    <span class="qfs-scramble inline-block whitespace-nowrap">PRESENCE.</span>
                </span>
            </h1>
            
            <div id="qfs-home-stats" class="grid grid-cols-1 md:grid-cols-3 gap-12 border-t pt-12 mt-24 qfs-reveal qfs-reveal-delay-2" style="border-color:var(--border);">
                <div class="md:col-span-1">
                    <p class="text-xl font-medium max-w-sm" style="color:var(--muted-foreground);">QuantumFrame Studio delivers cutting-edge website design, comprehensive SEO, and strategic digital campaigns across Madhya Pradesh.</p>
                </div>
                <div class="md:col-span-2 grid grid-cols-2 gap-8 text-sm">
                    <div>
                        <span class="block mb-2 uppercase tracking-widest text-xs font-bold" style="color:var(--muted-foreground);">Reach</span>
                        <span class="block text-4xl font-black" style="color:var(--foreground);">Madhya Pradesh</span>
                        <span class="block mt-1 text-sm" style="color:var(--muted-foreground);">Bhopal, Indore, Jabalpur, Gwalior</span>
                    </div>
                    <div>
                        <span class="block mb-2 uppercase tracking-widest text-xs font-bold" style="color:var(--muted-foreground);">Projects Delivered</span>
                        <span class="block text-4xl font-black" style="color:var(--foreground);">75+</span>
                        <span class="block mt-1 text-sm" style="color:var(--muted-foreground);">99.1% client satisfaction</span>
                    </div>
                </div>
            </div>

            <div class="mt-16 flex flex-wrap gap-4 qfs-reveal qfs-reveal-delay-3">
                <a href="/contact" class="qfs-shimmer font-bold tracking-widest uppercase text-sm px-8 py-4 transition-all duration-300 qfs-hoverable rounded-full" style="background:var(--primary);color:var(--primary-foreground);">
                    Get a Free Consultation
                </a>
                <a href="/services" class="qfs-shimmer font-bold tracking-widest uppercase text-sm px-8 py-4 transition-all duration-300 qfs-hoverable border rounded-full" style="border-color:var(--border);color:var(--foreground);background:transparent;">
                    Explore Services ↗
                </a>
            </div>
        </div>
    </main>

    <!-- Marquee Ticker -->
    <div class="overflow-hidden border-y py-5 select-none" style="background:var(--accent);border-color:var(--border);">
        <div class="qfs-marquee-track text-xs font-bold uppercase tracking-widest" style="color:var(--accent-foreground);">
            <span>Web Design</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>SEO Optimization</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Social Media Marketing</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>AI Video Creation</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>E-Commerce</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Content Strategy</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Facebook Marketing</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>UI/UX Design</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Web Design</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>SEO Optimization</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Social Media Marketing</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>AI Video Creation</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>E-Commerce</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Content Strategy</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>Facebook Marketing</span><span class="mx-8" style="color:var(--primary);">◆</span>
            <span>UI/UX Design</span><span class="mx-8" style="color:var(--primary);">◆</span>
        </div>
    </div>

    <!-- Why Choose Us Section -->
    <section class="py-32 px-6 md:px-12" style="background:var(--card);">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-4xl font-black tracking-tighter mb-4 uppercase qfs-reveal" style="color:var(--foreground);">Why Choose <span style="color:var(--primary);">Us.</span></h2>
            <p class="mb-16 max-w-xl qfs-reveal qfs-reveal-delay-1" style="color:var(--muted-foreground);">Discover what makes QuantumFrame Studio the preferred choice for businesses looking to excel in the digital landscape.</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-1 qfs-hoverable group transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--background);">
                    <span class="text-2xl mb-4 block">🚀</span>
                    <h3 class="font-bold text-xl mb-2" style="color:var(--foreground);">Expert Team</h3>
                    <p class="text-sm leading-relaxed" style="color:var(--muted-foreground);">Our skilled developers and marketers bring years of industry experience to every project.</p>
                </div>
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-2 qfs-hoverable group transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--background);">
                    <span class="text-2xl mb-4 block">💡</span>
                    <h3 class="font-bold text-xl mb-2" style="color:var(--foreground);">Innovative Solutions</h3>
                    <p class="text-sm leading-relaxed" style="color:var(--muted-foreground);">We use cutting-edge technologies and creative strategies to deliver exceptional results.</p>
                </div>
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-3 qfs-hoverable group transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--background);">
                    <span class="text-2xl mb-4 block">🛡️</span>
                    <h3 class="font-bold text-xl mb-2" style="color:var(--foreground);">24/7 Support</h3>
                    <p class="text-sm leading-relaxed" style="color:var(--muted-foreground);">Round-the-clock support ensures your business never stops growing.</p>
                </div>
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-2 qfs-hoverable group transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--background);">
                    <span class="text-2xl mb-4 block">📈</span>
                    <h3 class="font-bold text-xl mb-2" style="color:var(--foreground);">Proven Results</h3>
                    <p class="text-sm leading-relaxed" style="color:var(--muted-foreground);">Track record of successful projects and satisfied clients across various industries.</p>
                </div>
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-3 qfs-hoverable group transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--background);">
                    <span class="text-2xl mb-4 block">⚙️</span>
                    <h3 class="font-bold text-xl mb-2" style="color:var(--foreground);">Custom Approach</h3>
                    <p class="text-sm leading-relaxed" style="color:var(--muted-foreground);">Tailored solutions designed specifically for your business needs and goals.</p>
                </div>
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-4 qfs-hoverable group transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--background);">
                    <span class="text-2xl mb-4 block">💎</span>
                    <h3 class="font-bold text-xl mb-2" style="color:var(--foreground);">Best Value</h3>
                    <p class="text-sm leading-relaxed" style="color:var(--muted-foreground);">Premium quality services at competitive prices with transparent billing.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-32 px-6 md:px-12" style="background:var(--background);">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-4xl font-black tracking-tighter mb-4 uppercase qfs-reveal" style="color:var(--foreground);">What Our Clients <span style="color:var(--primary);">Say.</span></h2>
            <p class="mb-16 qfs-reveal qfs-reveal-delay-1" style="color:var(--muted-foreground);">Real results from real businesses across Madhya Pradesh.</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-1 qfs-hoverable transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--card);">
                    <div class="flex gap-1 mb-4">
                        <span style="color:var(--chart-3);">★★★★★</span>
                    </div>
                    <p class="text-sm italic mb-6 leading-relaxed" style="color:var(--foreground);">"QuantumFrame Studio delivered an exceptional website that perfectly showcases our gym equipment manufacturing business. Their attention to detail and professional approach helped us establish a strong online presence."</p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm" style="background:var(--primary);color:var(--primary-foreground);">SQ</div>
                        <div>
                            <h4 class="font-bold text-sm" style="color:var(--foreground);">Shahnawaz Quazi</h4>
                            <p class="text-xs uppercase tracking-widest" style="color:var(--muted-foreground);">Gym Equipment Manufacturing</p>
                        </div>
                    </div>
                </div>

                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-2 qfs-hoverable transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--card);">
                    <div class="flex gap-1 mb-4">
                        <span style="color:var(--chart-3);">★★★★★</span>
                    </div>
                    <p class="text-sm italic mb-6 leading-relaxed" style="color:var(--foreground);">"Working with QuantumFrame Studio was a great experience. They created a beautiful and functional website that has significantly improved our travel agency's booking rates and customer engagement."</p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm" style="background:var(--chart-2);color:white;">SA</div>
                        <div>
                            <h4 class="font-bold text-sm" style="color:var(--foreground);">Sajid Ali</h4>
                            <p class="text-xs uppercase tracking-widest" style="color:var(--muted-foreground);">Travel Agency</p>
                        </div>
                    </div>
                </div>

                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-3 qfs-hoverable transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--card);">
                    <div class="flex gap-1 mb-4">
                        <span style="color:var(--chart-3);">★★★★★</span>
                    </div>
                    <p class="text-sm italic mb-6 leading-relaxed" style="color:var(--foreground);">"The team at QuantumFrame Studio understood our vision perfectly. The website they created has helped us reach more customers and streamline our booking process. Highly recommended!"</p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm" style="background:var(--chart-3);color:white;">MR</div>
                        <div>
                            <h4 class="font-bold text-sm" style="color:var(--foreground);">Mr Riyaz</h4>
                            <p class="text-xs uppercase tracking-widest" style="color:var(--muted-foreground);">Service Business</p>
                        </div>
                    </div>
                </div>

                <div class="p-8 border rounded-3xl qfs-reveal qfs-reveal-delay-4 qfs-hoverable transition-all hover:shadow-lg" style="border-color:var(--border);background:var(--card);">
                    <div class="flex gap-1 mb-4">
                        <span style="color:var(--chart-3);">★★★★★</span>
                    </div>
                    <p class="text-sm italic mb-6 leading-relaxed" style="color:var(--foreground);">"QuantumFrame Studio's expertise in content management and video production has been instrumental in growing my YouTube channel. Their creative solutions exceeded my expectations."</p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm" style="background:var(--chart-5);color:white;">MO</div>
                        <div>
                            <h4 class="font-bold text-sm" style="color:var(--foreground);">Mr Obito</h4>
                            <p class="text-xs uppercase tracking-widest" style="color:var(--muted-foreground);">Content Creator</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <section class="py-24 px-6 md:px-12 text-center" style="background:var(--primary);">
        <div class="max-w-3xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-black tracking-tighter mb-6 uppercase qfs-reveal" style="color:var(--primary-foreground);">Ready to Turn Your <br>Dreams into Reality?</h2>
            <p class="text-lg mb-10 qfs-reveal qfs-reveal-delay-1" style="color:rgba(255,255,255,0.8);">Let's make a deal and bring your vision to life. Book a free consultation today.</p>
            <a href="/contact" class="qfs-shimmer inline-block font-bold tracking-widest uppercase text-sm px-12 py-5 transition-all qfs-hoverable qfs-reveal qfs-reveal-delay-2 rounded-full" style="background:var(--primary-foreground);color:var(--primary);">
                Book a Consultation
            </a>
        </div>
    </section>

</Layout>
