---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="About Us | QuantumFrame Studio — Bhopal's Digital Empire" 
    description="We cook up digital solutions that are 99.1% pure innovation. Meet the masterminds behind QuantumFrame Studio."
    pageId="about"
>
	<main id="qfs-about-main" class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-40 pb-16 relative" style="background:var(--background);">
        
        <!-- Hero Section -->
        <div id="qfs-about-content" class="relative z-10 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div id="qfs-about-text" class="space-y-8">
                <p id="qfs-about-eyebrow" class="uppercase tracking-widest text-xs font-bold qfs-reveal" style="color:var(--primary);">C₈H₁₁NO₂ → Digital Solutions</p>
                <h1 id="qfs-about-heading" class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.9] qfs-reveal qfs-reveal-delay-1" style="color:var(--foreground);">
                    <span class="qfs-scramble inline-block whitespace-nowrap">OUR</span> <br>
                    <span style="color:var(--primary);" class="qfs-scramble inline-block whitespace-nowrap">EMPIRE.</span>
                </h1>
                <p id="qfs-about-desc" class="text-xl font-medium leading-relaxed max-w-lg qfs-reveal qfs-reveal-delay-2" style="color:var(--muted-foreground);">
                    At QuantumFrame Studio, we cook up digital solutions that are 99.1% pure innovation. We're not just in the business. We're building an empire of cutting-edge tech and unparalleled creativity.
                </p>
                
                <div id="qfs-about-stats" class="pt-12 grid grid-cols-2 gap-8 border-t qfs-reveal qfs-reveal-delay-3" style="border-color:var(--border);">
                    <div>
                        <span class="block text-3xl font-black" style="color:var(--foreground);">⚗️ 99.1%</span>
                        <span class="block mt-2 text-sm uppercase tracking-widest font-bold" style="color:var(--muted-foreground);">Purity Level</span>
                    </div>
                    <div>
                        <span class="block text-3xl font-black" style="color:var(--foreground);">🔥 75+</span>
                        <span class="block mt-2 text-sm uppercase tracking-widest font-bold" style="color:var(--muted-foreground);">Cooked Projects</span>
                    </div>
                    <div>
                        <span class="block text-3xl font-black" style="color:var(--foreground);">⏰ 2+</span>
                        <span class="block mt-2 text-sm uppercase tracking-widest font-bold" style="color:var(--muted-foreground);">Years in Business</span>
                    </div>
                    <div>
                        <span class="block text-3xl font-black" style="color:var(--primary);">24/7</span>
                        <span class="block mt-2 text-sm uppercase tracking-widest font-bold" style="color:var(--muted-foreground);">Lab Operations</span>
                    </div>
                </div>
            </div>
            
            <div id="qfs-about-visual" class="relative border rounded-3xl p-12 aspect-square flex flex-col items-center justify-center text-center qfs-hoverable group transition-all hover:shadow-xl qfs-reveal-scale" style="background:var(--card);border-color:var(--border);">
                <div class="text-[6rem] mb-6 transition-transform group-hover:scale-110">🧪</div>
                <h3 class="text-2xl font-black mb-2 tracking-tight" style="color:var(--foreground);">The Formula</h3>
                <p class="text-sm max-w-xs" style="color:var(--muted-foreground);">Every line of code is measured with scientific precision. No contamination, no shortcuts. 99.1% pure innovation.</p>
            </div>
        </div>
    </main>

    <!-- Journey Timeline -->
    <section class="py-24 px-6 md:px-12" style="background:var(--card);">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-black tracking-tighter mb-16 uppercase qfs-reveal" style="color:var(--foreground);">Our Journey <span style="color:var(--primary);">— From Lab to Empire</span></h2>
            <div class="space-y-8">
                <div class="flex gap-8 items-start qfs-reveal qfs-reveal-delay-1">
                    <div class="text-3xl">🚀</div>
                    <div>
                        <h3 class="font-black text-xl mb-1" style="color:var(--foreground);">2023 — The Genesis</h3>
                        <p style="color:var(--muted-foreground);">QuantumFrame Studio was founded with a vision to revolutionize digital solutions in Madhya Pradesh.</p>
                    </div>
                </div>
                <div class="flex gap-8 items-start qfs-reveal qfs-reveal-delay-2">
                    <div class="text-3xl">📈</div>
                    <div>
                        <h3 class="font-black text-xl mb-1" style="color:var(--foreground);">2024 — Expansion</h3>
                        <p style="color:var(--muted-foreground);">Grew our team and diversified into multimedia production, social media management, and AI video creation.</p>
                    </div>
                </div>
                <div class="flex gap-8 items-start qfs-reveal qfs-reveal-delay-3">
                    <div class="text-3xl">👑</div>
                    <div>
                        <h3 class="font-black text-xl mb-1" style="color:var(--foreground);">2025 — Empire Building</h3>
                        <p style="color:var(--muted-foreground);">Established ourselves as a full-service digital agency with 75+ successful projects across Madhya Pradesh.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The Cooks / Team Section -->
    <section class="py-32 px-6 md:px-12" style="background:var(--background);">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-4xl font-black tracking-tighter mb-4 uppercase qfs-reveal" style="color:var(--foreground);">The Cooks</h2>
            <p class="mb-16 max-w-2xl text-lg qfs-reveal qfs-reveal-delay-1" style="color:var(--muted-foreground);">Meet the masterminds behind the operation. The perfect blend of technology and creativity creating explosive digital solutions.</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Aydin -->
                <div class="p-8 border rounded-3xl qfs-hoverable group transition-all hover:shadow-xl qfs-reveal qfs-reveal-delay-1" style="background:var(--card);border-color:var(--border);">
                    <span class="text-xs font-bold uppercase tracking-widest mb-3 block px-3 py-1 rounded-full w-fit" style="background:var(--accent);color:var(--primary);">⚠️ DANGER</span>
                    <h3 class="font-black text-3xl mb-1" style="color:var(--foreground);">Aydin Khan</h3>
                    <p class="font-semibold mb-4" style="color:var(--primary);">Chief Architect & Operations Director</p>
                    <p class="text-sm italic mb-6 px-4 py-3  border-l-4 rounded-xl" style="color:var(--muted-foreground);border-color:var(--primary);background:var(--accent);">"I architect the code, orchestrate the operations, and guide the vision!"</p>
                    <p class="text-sm leading-relaxed mb-6" style="color:var(--muted-foreground);">Visionary leader orchestrating digital excellence at every level. Master of full-stack development who handles everything from strategic code architecture to daily operations and team guidance.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:var(--accent);color:var(--accent-foreground);">Full-Stack Alchemy</span>
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:var(--accent);color:var(--accent-foreground);">99.1% Pure Code</span>
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:var(--accent);color:var(--accent-foreground);">Empire Building</span>
                    </div>
                </div>

                <!-- Nauman -->
                <div class="p-8 border rounded-3xl qfs-hoverable group transition-all hover:shadow-xl qfs-reveal qfs-reveal-delay-2" style="background:var(--card);border-color:var(--border);">
                    <span class="text-xs font-bold uppercase tracking-widest mb-3 block px-3 py-1 rounded-full w-fit" style="background:rgba(247,185,40,0.15);color:var(--chart-3);">⚖️ LEGAL</span>
                    <h3 class="font-black text-3xl mb-1" style="color:var(--foreground);">Nauman Zafar</h3>
                    <p class="font-semibold mb-4" style="color:var(--chart-3);">The Saul of Operations</p>
                    <p class="text-sm italic mb-6 px-4 py-3  border-l-4 rounded-xl" style="color:var(--muted-foreground);border-color:var(--chart-3);background:rgba(247,185,40,0.08);">"It's all good, man!"</p>
                    <p class="text-sm leading-relaxed mb-6" style="color:var(--muted-foreground);">The smooth operator who keeps everything running like clockwork. When things get complicated, better call Nauman. Exceptional organizational skills and a talent for problem-solving.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:rgba(247,185,40,0.15);color:var(--chart-3);">Strategic Planning</span>
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:rgba(247,185,40,0.15);color:var(--chart-3);">Project Management</span>
                    </div>
                </div>

                <!-- Uneeb -->
                <div class="p-8 border rounded-3xl qfs-hoverable group transition-all hover:shadow-xl qfs-reveal qfs-reveal-delay-3" style="background:var(--card);border-color:var(--border);">
                    <span class="text-xs font-bold uppercase tracking-widest mb-3 block px-3 py-1 rounded-full w-fit" style="background:rgba(30,157,241,0.12);color:var(--primary);">🎬 DIRECTOR</span>
                    <h3 class="font-black text-3xl mb-1" style="color:var(--foreground);">Sheikh Uneeb</h3>
                    <p class="font-semibold mb-4" style="color:var(--primary);">The Gus of Visual Storytelling</p>
                    <p class="text-sm italic mb-6 px-4 py-3  border-l-4 rounded-xl" style="color:var(--muted-foreground);border-color:var(--primary);background:var(--accent);">"I hide in plain sight."</p>
                    <p class="text-sm leading-relaxed mb-6" style="color:var(--muted-foreground);">A perfectionist with an eye for detail. From concept to final cut, he crafts visual narratives that captivate and engage. His meticulous approach to filmmaking ensures every frame is a work of art.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:var(--accent);color:var(--accent-foreground);">Filmmaking</span>
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:var(--accent);color:var(--accent-foreground);">Visual Effects</span>
                    </div>
                </div>

                <!-- Nabeel -->
                <div class="p-8 border rounded-3xl qfs-hoverable group transition-all hover:shadow-xl qfs-reveal qfs-reveal-delay-4" style="background:var(--card);border-color:var(--border);">
                    <span class="text-xs font-bold uppercase tracking-widest mb-3 block px-3 py-1 rounded-full w-fit" style="background:rgba(224,36,94,0.12);color:var(--chart-5);">🔥 CREATOR</span>
                    <h3 class="font-black text-3xl mb-1" style="color:var(--foreground);">Nabeel Khan</h3>
                    <p class="font-semibold mb-4" style="color:var(--chart-5);">The Pinkman of Social Creativity</p>
                    <p class="text-sm italic mb-6 px-4 py-3  border-l-4 rounded-xl" style="color:var(--muted-foreground);border-color:var(--chart-5);background:rgba(224,36,94,0.08);">"Yeah, we make content that's straight fire!"</p>
                    <p class="text-sm leading-relaxed mb-6" style="color:var(--muted-foreground);">Like Jesse Pinkman, he brings raw creativity and passionate energy. Pure talent when it comes to crafting engaging content and building authentic brand connections. Turns ordinary campaigns into viral gold.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:rgba(224,36,94,0.12);color:var(--chart-5);">Social Media</span>
                        <span class="px-3 py-1 text-xs font-bold rounded-full" style="background:rgba(224,36,94,0.12);color:var(--chart-5);">Creative Strategy</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-6 md:px-12 text-center" style="background:var(--primary);">
        <div class="max-w-3xl mx-auto">
            <h2 class="text-5xl font-black tracking-tighter mb-6 uppercase qfs-reveal" style="color:var(--primary-foreground);">Ready to Cook <br>Something Great?</h2>
            <p class="text-lg mb-12 qfs-reveal qfs-reveal-delay-1" style="color:rgba(255,255,255,0.8);">Let's discuss how we can help bring your digital vision to life with our 99.1% pure expertise. We are in the empire business.</p>
            <a href="/contact" class="qfs-shimmer inline-block font-bold tracking-widest uppercase text-sm px-12 py-5 transition-all qfs-hoverable qfs-reveal qfs-reveal-delay-2 rounded-full" style="background:var(--primary-foreground);color:var(--primary);">
                Start Cooking
            </a>
        </div>
    </section>

</Layout>
